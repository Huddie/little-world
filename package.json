{
  "name": "little-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "worker:dev": "wrangler dev",
    "build": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "worker:typecheck": "tsc -p tsconfig.worker.json --noEmit",
    "node:typecheck": "tsc -p tsconfig.node.json --noEmit",
    "mcp:story-world": "tsx src/mcp/story-world-server.ts",
    "resend:setup-domain": "tsx scripts/setup-resend-domain.ts",
    "resend:verify-domain": "tsx scripts/verify-resend-domain.ts",
    "cloudflare:setup-dns": "tsx scripts/setup-cloudflare-dns.ts",
    "deploy": "pnpm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply little-world --local",
    "db:migrate:remote": "wrangler d1 migrations apply little-world --remote",
    "db:seed": "wrangler d1 execute little-world --local --file drizzle/seed.sql"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "@hono/zod-validator": "0.9.1",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "lucide-react": "0.468.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "openai": "7.9.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.1.1",
    "resend": "6.25.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260902.1",
    "@eslint/js": "9.34.0",
    "@vitejs/plugin-react": "5.0.1",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.31.10",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "tsx": "4.20.5",
    "vite": "6.0.5",
    "vitest": "3.2.4",
    "wrangler": "4.128.0"
  },
  "packageManager": "pnpm@10.15.0"
}
